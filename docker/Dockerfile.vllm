FROM vllm/vllm-openai:v0.19.0

# AS-006a: optional coordinated torch-stack overlay.
#
# When build_managed.py threads --build-arg for these keys, the overlay
# replaces whatever torch/torchaudio/torchvision the upstream vllm-openai
# base image baked in. When the ARGs are unset (backward-compatible default),
# this layer is a no-op and the base image's torch stack is kept as-is.
#
# The overlay is gated on BOTH TORCH_INDEX_URL and TORCH_VERSION being set,
# so a partial pass (e.g. index without version) does not silently fall back
# to latest-on-index. TORCHAUDIO_VERSION and TORCHVISION_VERSION are optional —
# they are appended only if provided, using ${VAR:+value} bash expansion.
#
# Transitive-dep floor alignment: numpy==2.2.6 and setuptools==80.10.2 are
# hard-pinned inside the same overlay step. Without these, `pip install
# --force-reinstall torch==...` pulls latest numpy (2.4.4) and setuptools
# (82.0.1) as transitive deps of torch, which then violate lmcache (numpy
# <=2.2.6, setuptools <81.0.0), mistral-common (numpy <2.4), numba
# (numpy <2.3), and vLLM 0.19.0's own setuptools <81.0.0 pin. The 2.2.6 /
# 80.10.2 values are what vLLM 0.19.0's resolver selects on a clean LAN
# build_runner.py build (captured from the running 122b production replica
# aff65fe3 on 2026-04-14) — a production-proven coordinated stack.
ARG TORCH_INDEX_URL=""
ARG TORCH_VERSION=""
ARG TORCHAUDIO_VERSION=""
ARG TORCHVISION_VERSION=""

RUN if [ -n "$TORCH_INDEX_URL" ] && [ -n "$TORCH_VERSION" ]; then \
      pip install --force-reinstall --no-cache-dir \
        --index-url "$TORCH_INDEX_URL" \
        --extra-index-url https://pypi.org/simple \
        "torch==${TORCH_VERSION}" \
        ${TORCHAUDIO_VERSION:+"torchaudio==${TORCHAUDIO_VERSION}"} \
        ${TORCHVISION_VERSION:+"torchvision==${TORCHVISION_VERSION}"} \
        "numpy==2.2.6" \
        "setuptools==80.10.2"; \
    fi

# AS-006d: install kvcached from the fork's own source (this build context)
# instead of the PyPI release. Required so fork patches (e.g. the per-engine
# fallback to stock vLLM when kv_cache_config uses unsupported specs such as
# MambaSpec in Qwen3.5-122B-A10B) actually ship into the runtime image.
#
# Step 1 — pre-install kvcached's lightweight runtime deps (wrapt,
# posix_ipc). numpy is already pinned at 2.2.6 by the AS-006a overlay above,
# and torch/vllm come from the base image. We install wrapt+posix_ipc
# explicitly so we can then use --no-deps on the kvcached source install to
# keep the big torch/numpy/setuptools pins intact. Without wrapt (kvcached's
# declared dep) kvcached.integration.vllm.autopatch.when_imported() fails at
# import time, so the vLLM patches never register and the image ships
# kvcached but runs stock vLLM for every engine.
RUN pip install --no-cache-dir "wrapt>=1.15" "posix_ipc>=1.0"

# Step 2 — install kvcached from the fork source (this build context) with
# --no-deps so the torch/numpy/setuptools overlay from AS-006a is left
# verbatim in place. kvcached's own runtime deps (vllm, torch) are already
# satisfied by the vllm-openai base + AS-006a overlay; wrapt and posix_ipc
# come from Step 1.
COPY . /tmp/kvcached-src
RUN LIBRARY_PATH=/usr/local/cuda/lib64/stubs:${LIBRARY_PATH} \
    pip install --no-deps /tmp/kvcached-src --no-build-isolation

ENV ENABLE_KVCACHED=true
ENV KVCACHED_AUTOPATCH=1
ENV KVCACHED_IPC_NAME=VLLM

EXPOSE 8080 12346 30000 30001

ENTRYPOINT []
CMD ["bash"]
